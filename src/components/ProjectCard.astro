---
export interface Technology {
  name: string;
  iconClass?: string; // e.g., "devicon-nestjs-plain"
  iconImg?: string; // e.g., "assets/img/icon.svg"
}

export interface Link {
  url: string;
  label: string;
  iconClass?: string; // e.g., "fab fa-github"
}

interface Props {
  title: string;
  image: string;
  description: string;
  technologies: Technology[];
  links: Link[];
  highlights?: { label: string; text: string }[];
  slug?: string;
  images?: string[];
  /** Stack groups used by the project filter (e.g. "node cloud"). */
  tags?: string[];
  status?: 'in-progress';
  /** Lead card: highlights open one at a time instead of showing every paragraph. */
  accordion?: boolean;
}

import { useTranslations } from '../i18n/utils';

const { title, image, images, description, technologies, links, slug, highlights, tags = [], status, accordion = false } = Astro.props;
const t = useTranslations('en');
const pageUrl = slug ? `${import.meta.env.BASE_URL}projects/${slug}/` : undefined;
---

<article class="project" data-slug={slug} data-tags={tags.join(' ')}>
  <div class="project-image" data-images={images && images.length > 0 ? JSON.stringify(images) : undefined}>
    <img src={image} alt={title} loading="lazy" decoding="async" />
    {
      images && images.length > 1 && (
        <span class="image-count" aria-hidden="true">
          <i class="fas fa-images" /> {images.length}
        </span>
      )
    }
  </div>

  <div class="project-content">
    {
      status === 'in-progress' && (
        <p class="project-status"><span class="now-dot" aria-hidden="true" /> <span data-t="projects.inProgress">{t.projects.inProgress}</span></p>
      )
    }
    <h3>{pageUrl ? <a href={pageUrl} class="project-title-link">{title}</a> : title}</h3>

    {
      highlights && highlights.length > 0 ? (
        <ul class:list={['project-highlights', { accordion }]}>
          {highlights.map((item, i) =>
            accordion ? (
              <li>
                <details name={`highlights-${slug}`} open={i === 0}>
                  <summary data-h-label>{item.label}</summary>
                  <p data-h-text set:html={item.text} />
                </details>
              </li>
            ) : (
              <li>
                <strong data-h-label>{item.label}:</strong> <span data-h-text set:html={item.text} />
              </li>
            )
          )}
        </ul>
      ) : (
        <p set:html={description} />
      )
    }

    <div class="technologies">
      {
        technologies.map((tech) => (
          <span>
            {tech.iconClass && <i class={`${tech.iconClass} colored`} />}
            {tech.iconImg && (
              <i>
                <img src={tech.iconImg} alt="" style="height: 1em; width: auto;" />
              </i>
            )}
            {tech.name}
          </span>
        ))
      }
    </div>

    <div class="project-links">
      {
        links.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer">
            {link.iconClass && <i class={link.iconClass} />}
            {link.label}
          </a>
        ))
      }
      {
        slug && (
          <button class="view-details-btn" data-slug={slug} data-i18n="projects.viewDetails">
            <i class="fas fa-layer-group" /> {t.projects.viewDetails}
          </button>
        )
      }
      {
        pageUrl && (
          <a href={pageUrl} class="view-page-link">
            <i class="fas fa-arrow-right" aria-hidden="true" /> <span data-t="projects.page.fullPage">{t.projects.page.fullPage}</span>
          </a>
        )
      }
    </div>
  </div>
</article>
