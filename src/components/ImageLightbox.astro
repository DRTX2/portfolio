<!-- Image Lightbox Modal -->
<div id="imageModal" class="lb-overlay" aria-modal="true" role="dialog" aria-label="Image viewer">
  <!-- Clickable backdrop to close -->
  <div class="lb-backdrop" id="lbBackdrop"></div>

  <!-- Top bar: zoom controls (left) + close (right) -->
  <div class="lb-topbar">
    <div class="lb-zoom-controls">
      <button class="lb-btn" id="lbZoomIn" title="Zoom In" aria-label="Zoom In">
        <i class="fas fa-search-plus"></i>
      </button>
      <button class="lb-btn" id="lbZoomOut" title="Zoom Out" aria-label="Zoom Out">
        <i class="fas fa-search-minus"></i>
      </button>
      <button class="lb-btn" id="lbResetZoom" title="Reset Zoom" aria-label="Reset Zoom">
        <i class="fas fa-compress-arrows-alt"></i>
      </button>
    </div>
    <button class="lb-btn lb-close" id="lbClose" title="Close" aria-label="Close">
      <i class="fas fa-times"></i>
    </button>
  </div>

  <!-- Prev / Next arrows (only shown when multiple images) -->
  <button class="lb-arrow lb-arrow-prev" id="lbPrev" aria-label="Previous image">
    <i class="fas fa-chevron-left"></i>
  </button>
  <button class="lb-arrow lb-arrow-next" id="lbNext" aria-label="Next image">
    <i class="fas fa-chevron-right"></i>
  </button>

  <!-- Main image area -->
  <div class="lb-image-area" id="lbImageArea">
    <img class="lb-image" id="lbImage" src="" alt="Project image" draggable="false" />
  </div>

  <!-- Thumbnail strip (only shown when multiple images) -->
  <div class="lb-thumbs" id="lbThumbs"></div>
</div>

<style is:global>
  /* ─── Full-screen overlay ─────────────────────────────────── */
  .lb-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9000;
    background: rgba(0, 0, 0, 0.92);
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .lb-overlay.active {
    display: flex;
  }

  /* ─── Backdrop (click to close) ───────────────────────────── */
  .lb-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    cursor: zoom-out;
  }

  /* ─── All interactive layers above backdrop ───────────────── */
  .lb-topbar,
  .lb-arrow,
  .lb-image-area,
  .lb-thumbs {
    position: relative;
    z-index: 1;
  }

  /* ─── Top bar ─────────────────────────────────────────────── */
  .lb-topbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(to bottom, rgba(0,0,0,0.6), transparent);
    z-index: 2;
    pointer-events: none;
  }

  .lb-zoom-controls {
    display: flex;
    gap: 8px;
    pointer-events: auto;
  }

  /* ─── Shared button style ─────────────────────────────────── */
  .lb-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(15, 23, 42, 0.75);
    color: #fff;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    pointer-events: auto;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition: background 0.2s ease, transform 0.2s ease, color 0.2s ease;
    flex-shrink: 0;
  }
  .lb-btn:hover {
    background: var(--color-primary, #22c55e);
    color: #111;
    transform: scale(1.1);
  }

  .lb-close {
    pointer-events: auto;
  }

  /* ─── Prev / Next arrows ──────────────────────────────────── */
  .lb-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(15, 23, 42, 0.75);
    color: #fff;
    font-size: 1.4rem;
    display: none;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
    pointer-events: auto;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition: background 0.2s ease, transform 0.2s ease, color 0.2s ease;
  }
  .lb-arrow:hover {
    background: var(--color-primary, #22c55e);
    color: #111;
    transform: translateY(-50%) scale(1.1);
  }
  .lb-arrow-prev { left: 20px; }
  .lb-arrow-next { right: 20px; }

  /* ─── Image area ──────────────────────────────────────────── */
  .lb-image-area {
    flex: 1;
    width: 100%;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 90px 16px 90px;
    box-sizing: border-box;
    overflow: hidden;
  }

  /* ─── The actual image ────────────────────────────────────── */
  .lb-image {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    user-select: none;
    -webkit-user-drag: none;
    transform-origin: center;
    transition: opacity 0.22s ease;
    display: block;
  }
  .lb-image.fading { opacity: 0; }
  .lb-image.zooming { transition: opacity 0.22s ease, transform 0.2s ease-out; }

  /* ─── Thumbnail strip ─────────────────────────────────────── */
  .lb-thumbs {
    display: none;
    width: 100%;
    max-width: min(90vw, 900px);
    gap: 10px;
    padding: 12px 16px;
    margin-bottom: 16px;
    overflow-x: auto;
    background: rgba(15, 23, 42, 0.65);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    pointer-events: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .lb-thumbs::-webkit-scrollbar { display: none; }
  .lb-thumbs.visible { display: flex; }

  .lb-thumb {
    width: 68px;
    height: 68px;
    object-fit: cover;
    border-radius: 6px;
    border: 2px solid transparent;
    opacity: 0.5;
    flex-shrink: 0;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .lb-thumb:hover { opacity: 0.8; transform: translateY(-3px); }
  .lb-thumb.active {
    opacity: 1;
    border-color: var(--color-primary, #22c55e);
    box-shadow: 0 0 12px rgba(34, 197, 94, 0.45);
  }

  /* ─── Responsive ──────────────────────────────────────────── */
  @media (max-width: 768px) {
    .lb-image-area { padding: 72px 60px 12px 60px; }
    .lb-arrow { width: 42px; height: 42px; font-size: 1.1rem; }
    .lb-arrow-prev { left: 10px; }
    .lb-arrow-next { right: 10px; }
    .lb-thumb { width: 52px; height: 52px; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const lbOverlay   = document.getElementById('imageModal') as HTMLElement | null;
    const imgEl       = document.getElementById('lbImage')    as HTMLImageElement | null;
    const backdrop    = document.getElementById('lbBackdrop');
    const closeBtn    = document.getElementById('lbClose');
    const prevBtn     = document.getElementById('lbPrev')     as HTMLButtonElement | null;
    const nextBtn     = document.getElementById('lbNext')     as HTMLButtonElement | null;
    const thumbsEl    = document.getElementById('lbThumbs');
    const zoomInBtn   = document.getElementById('lbZoomIn');
    const zoomOutBtn  = document.getElementById('lbZoomOut');
    const resetZoomBtn= document.getElementById('lbResetZoom');

    if (!lbOverlay || !imgEl || !closeBtn) return;

    // ── PORTAL: move overlay to <body> so position:fixed works relative to viewport ──
    // This avoids issues with backdrop-filter/transform on ancestor elements
    if (lbOverlay.parentElement !== document.body) {
      document.body.appendChild(lbOverlay);
    }

    // ── State ─────────────────────────────────────────────────
    let images: string[] = [];
    let idx = 0;
    let zoom = 1;
    let tx = 0, ty = 0;
    let dragging = false;
    let dragStartX = 0, dragStartY = 0;
    const STEP = 0.4;
    const MAX_ZOOM = 4;
    const MIN_ZOOM = 0.5;

    // ── Transform helpers ──────────────────────────────────────
    const applyTransform = (smooth = false) => {
      if (smooth) imgEl.classList.add('zooming');
      else imgEl.classList.remove('zooming');
      imgEl.style.transform = `translate(${tx}px, ${ty}px) scale(${zoom})`;
      imgEl.style.cursor = zoom > 1 ? 'grab' : 'default';
    };

    const resetTransform = () => { zoom = 1; tx = 0; ty = 0; applyTransform(true); };

    const doZoom = (delta: number) => {
      zoom = Math.max(MIN_ZOOM, Math.min(MAX_ZOOM, zoom + delta));
      if (zoom === 1) { tx = 0; ty = 0; }
      applyTransform(true);
    };

    // ── Drag ──────────────────────────────────────────────────
    imgEl.addEventListener('mousedown', e => {
      if (zoom > 1) {
        dragging = true;
        dragStartX = e.clientX - tx;
        dragStartY = e.clientY - ty;
        imgEl.style.cursor = 'grabbing';
      }
    });
    window.addEventListener('mousemove', e => {
      if (dragging) { tx = e.clientX - dragStartX; ty = e.clientY - dragStartY; applyTransform(); }
    });
    window.addEventListener('mouseup', () => {
      dragging = false;
      if (zoom > 1) imgEl.style.cursor = 'grab';
    });

    imgEl.addEventListener('touchstart', e => {
      if (zoom > 1 && e.touches.length === 1) {
        dragging = true;
        dragStartX = e.touches[0].clientX - tx;
        dragStartY = e.touches[0].clientY - ty;
      }
    }, { passive: false });
    window.addEventListener('touchmove', e => {
      if (dragging && e.touches.length === 1) {
        e.preventDefault();
        tx = e.touches[0].clientX - dragStartX;
        ty = e.touches[0].clientY - dragStartY;
        applyTransform();
      }
    }, { passive: false });
    window.addEventListener('touchend', () => { dragging = false; });

    // Wheel zoom
    lbOverlay.addEventListener('wheel', (e: WheelEvent) => {
      if (!lbOverlay.classList.contains('active')) return;
      e.preventDefault();
      doZoom(e.deltaY < 0 ? STEP * 0.6 : -STEP * 0.6);
    }, { passive: false });

    // Zoom buttons
    zoomInBtn?.addEventListener('click',   e => { e.stopPropagation(); doZoom(STEP); });
    zoomOutBtn?.addEventListener('click',  e => { e.stopPropagation(); doZoom(-STEP); });
    resetZoomBtn?.addEventListener('click',e => { e.stopPropagation(); resetTransform(); });

    // ── Carousel ──────────────────────────────────────────────
    const refreshThumbs = () => {
      if (!thumbsEl) return;
      thumbsEl.querySelectorAll('.lb-thumb').forEach((t, i) => {
        t.classList.toggle('active', i === idx);
        if (i === idx) (t as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      });
    };

    const goTo = (newIdx: number) => {
      if (!images.length) return;
      idx = (newIdx + images.length) % images.length;
      imgEl.classList.add('fading');
      setTimeout(() => {
        imgEl.src = images[idx];
        resetTransform();
        refreshThumbs();
        imgEl.classList.remove('fading');
      }, 220);
    };

    prevBtn?.addEventListener('click', e => { e.stopPropagation(); goTo(idx - 1); });
    nextBtn?.addEventListener('click', e => { e.stopPropagation(); goTo(idx + 1); });

    // ── Open ──────────────────────────────────────────────────
    document.querySelectorAll('.project-image').forEach(container => {
      container.addEventListener('click', () => {
        const img = container.querySelector('img');
        const raw = container.getAttribute('data-images');
        try { images = raw ? JSON.parse(raw) : (img ? [img.src] : []); }
        catch { images = img ? [img.src] : []; }
        if (!images.length) return;

        idx = 0;
        imgEl.src = images[0];
        resetTransform();
        lbOverlay.classList.add('active');
        document.body.style.overflow = 'hidden';

        const multi = images.length > 1;

        if (prevBtn && nextBtn) {
          prevBtn.style.display = multi ? 'flex' : 'none';
          nextBtn.style.display = multi ? 'flex' : 'none';
        }

        if (thumbsEl) {
          thumbsEl.innerHTML = '';
          if (multi) {
            images.forEach((src, i) => {
              const t = document.createElement('img');
              t.src = src;
              t.className = 'lb-thumb' + (i === 0 ? ' active' : '');
              t.addEventListener('click', e => { e.stopPropagation(); if (i !== idx) goTo(i); });
              thumbsEl.appendChild(t);
            });
            thumbsEl.classList.add('visible');
          } else {
            thumbsEl.classList.remove('visible');
          }
        }
      });
    });

    // ── Close ─────────────────────────────────────────────────
    const close = () => {
      lbOverlay.classList.remove('active');
      document.body.style.overflow = '';
      resetTransform();
    };
    closeBtn.addEventListener('click', close);
    backdrop?.addEventListener('click', close);

    document.addEventListener('keydown', e => {
      if (!lbOverlay.classList.contains('active')) return;
      if (e.key === 'Escape') close();
      if (images.length > 1) {
        if (e.key === 'ArrowLeft')  goTo(idx - 1);
        if (e.key === 'ArrowRight') goTo(idx + 1);
      }
    });
  });
</script>
