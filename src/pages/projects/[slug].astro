---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import AtalayaFlow from '../../components/AtalayaFlow.astro';
import { projects } from '../../data/projects';
import { useTranslations } from '../../i18n/utils';

// One page per project, built from the same data and translations as the card and the modal.
export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, prev, next } = Astro.props;
const t = useTranslations('en');
const base = import.meta.env.BASE_URL;
const home = (hash = '') => `${base}${hash}`;
const pageUrl = (slug: string) => `${base}projects/${slug}/`;
const images = project.images?.length ? project.images : [project.image];
const paragraphs = (project.detailedDescription ?? '').split(/\n\n+/).filter(Boolean);
const navItems = [
  { href: home(), key: 'nav.home' },
  { href: home('#projects'), key: 'nav.projects' },
  { href: home('#contact'), key: 'nav.contact' },
];
---

<Layout title={`${project.title} | David Manjarres`}>
  <Header navItems={navItems} />
  <main class="project-page" data-slug={project.slug} data-images={JSON.stringify(images)}>
    <section class="pp-section pp-hero">
      <a class="pp-back" href={home('#projects')}><i class="fas fa-arrow-left" aria-hidden="true"></i> <span data-t="projects.page.back">{t.projects.page.back}</span></a>
      {project.status === 'in-progress' && (
        <p class="project-status"><span class="now-dot" aria-hidden="true" /> <span data-t="projects.inProgress">{t.projects.inProgress}</span></p>
      )}
      <h1 data-p="title">{project.title}</h1>
      <p class="pp-lede" data-p="description" set:html={project.description} />
      {project.links.length > 0 && (
        <div class="pp-links">
          {project.links.map((link, i) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class:list={['pp-link', { primary: i === 0 }]}>
              {link.iconClass && <i class={link.iconClass} aria-hidden="true" />} {link.label}
            </a>
          ))}
        </div>
      )}
      <ul class="pp-tech" aria-label="Stack">
        {project.technologies.map((tech) => (
          <li>
            {tech.iconClass && <i class={`${tech.iconClass} colored`} aria-hidden="true" />}
            {tech.iconImg && <img src={tech.iconImg} alt="" width="16" height="16" loading="lazy" />}
            {tech.name}
          </li>
        ))}
      </ul>
      <button type="button" class="pp-cover" data-open-gallery="0" aria-label={`Open the ${project.title} gallery`}>
        <img src={project.image} alt={project.title} />
        {images.length > 1 && <span class="image-count" aria-hidden="true"><i class="fas fa-images" /> {images.length}</span>}
      </button>
    </section>

    {project.slug === 'atalaya' && <AtalayaFlow />}

    {project.highlights?.length && (
      <section class="pp-section">
        <h2 data-t="projects.page.highlights">{t.projects.page.highlights}</h2>
        <ul class="pp-highlights" data-p="highlights">
          {project.highlights.map((h) => (
            <li><strong>{h.label}</strong><span set:html={h.text} /></li>
          ))}
        </ul>
      </section>
    )}

    {paragraphs.length > 0 && (
      <section class="pp-section pp-overview">
        <h2 data-t="projects.modal.overview">{t.projects.modal.overview}</h2>
        <div class="pp-prose" data-p="detailedDescription">
          {paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </section>
    )}

    {project.features?.length && (
      <section class="pp-section">
        <h2 data-t="projects.modal.keyFeatures">{t.projects.modal.keyFeatures}</h2>
        <ul class="pp-features">
          {project.features.map((f) => <li>{f}</li>)}
        </ul>
      </section>
    )}

    {(project.challenges?.length || project.solutions?.length) && (
      <section class="pp-section pp-tradeoffs">
        <div>
          <h2 data-t="projects.modal.keyChallenges">{t.projects.modal.keyChallenges}</h2>
          <ol data-p="challenges">{(project.challenges ?? []).map((c) => <li>{c}</li>)}</ol>
        </div>
        <div>
          <h2 data-t="projects.modal.technicalSolutions">{t.projects.modal.technicalSolutions}</h2>
          <ol data-p="solutions">{(project.solutions ?? []).map((s) => <li>{s}</li>)}</ol>
        </div>
      </section>
    )}

    {images.length > 1 && (
      <section class="pp-section">
        <h2 data-t="projects.page.gallery">{t.projects.page.gallery}</h2>
        <div class="pp-gallery">
          {images.map((src, i) => (
            <button type="button" data-open-gallery={i} aria-label={`Image ${i + 1} of ${images.length}`}>
              <img src={src} alt="" loading="lazy" />
            </button>
          ))}
        </div>
      </section>
    )}

    <nav class="pp-section pp-pager" aria-label="More projects">
      <a href={pageUrl(prev.slug)}><span data-t="projects.page.previous">{t.projects.page.previous}</span><strong data-p-title={prev.slug}>{prev.title}</strong></a>
      <a href={pageUrl(next.slug)} class="next"><span data-t="projects.page.next">{t.projects.page.next}</span><strong data-p-title={next.slug}>{next.title}</strong></a>
    </nav>
  </main>
  <Footer />
  <ImageLightbox />
</Layout>

<script>
  import en from '../../i18n/en.json';
  import es from '../../i18n/es.json';

  const dict: Record<string, any> = { en, es };
  const page = document.querySelector<HTMLElement>('.project-page')!;
  const slug = page.dataset.slug!;
  const images: string[] = JSON.parse(page.dataset.images || '[]');

  page.querySelectorAll<HTMLElement>('[data-open-gallery]').forEach((el) =>
    el.addEventListener('click', () => {
      const title = page.querySelector('h1')?.textContent ?? '';
      (window as any).openLightbox?.(images, title, Number(el.dataset.openGallery));
    }),
  );

  const list = (sel: string, items: string[] | undefined) => {
    const el = page.querySelector(sel);
    if (!el || !items) return;
    el.replaceChildren(...items.map((text) => Object.assign(document.createElement('li'), { textContent: text })));
  };

  // Project texts follow the language switcher, like the cards and the modal (EN is the source).
  function translate() {
    let lang = 'en';
    try { lang = localStorage.getItem('lang') || 'en'; } catch {}
    const items = dict[lang]?.projects?.items ?? {};
    const item = items[slug] ?? en.projects.items[slug as keyof typeof en.projects.items];
    if (item) {
      const title = page.querySelector('[data-p="title"]');
      if (title && item.title) { title.textContent = item.title; document.title = `${item.title} | David Manjarres`; }
      const lede = page.querySelector('[data-p="description"]');
      if (lede && item.description) lede.innerHTML = item.description;
      const highlights = page.querySelector('[data-p="highlights"]');
      if (highlights && item.highlights) {
        highlights.replaceChildren(...item.highlights.map((h: { label: string; text: string }) => {
          const li = document.createElement('li');
          const strong = Object.assign(document.createElement('strong'), { textContent: h.label });
          const span = document.createElement('span');
          span.innerHTML = h.text; // trusted: our own translation files
          li.append(strong, span);
          return li;
        }));
      }
      const prose = page.querySelector('[data-p="detailedDescription"]');
      if (prose && item.detailedDescription) {
        prose.replaceChildren(...item.detailedDescription.split(/\n\n+/).map((p: string) => Object.assign(document.createElement('p'), { textContent: p })));
      }
      list('[data-p="challenges"]', item.challenges);
      list('[data-p="solutions"]', item.solutions);
    }
    page.querySelectorAll<HTMLElement>('[data-p-title]').forEach((el) => {
      const other = items[el.dataset.pTitle!];
      if (other?.title) el.textContent = other.title;
    });
  }

  translate();
  window.addEventListener('languagechange', translate);
</script>
